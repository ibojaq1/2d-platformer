# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── NerdyTips (subscription account required) ──
NERDYTIPS_USERNAME=your_nerdytips_username
NERDYTIPS_PASSWORD=your_nerdytips_password
NERDYTIPS_BASE_URL=https://nerdytips.com

# ── SportyBet (account required for booking codes) ──
SPORTYBET_PHONE=your_sportybet_phone_number
SPORTYBET_PASSWORD=your_sportybet_password
SPORTYBET_BASE_URL=https://www.sportybet.com/ng

# ── Paystack (payment gateway) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxx
PREMIUM_PRICE_KOBO=300000

# ── Database ──
DB_PATH=./data/betcode.db

# ── Rate limits (free tier) ──
FREE_MAX_MATCHES=5
FREE_MAX_SLIPS_PER_DAY=2

# ── Puppeteer ──
PUPPETEER_HEADLESS=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ── Server (for Paystack webhooks) ──
PORT=3000
SERVER_BASE_URL=https://your-server.com
